# Mail settings for the contact form ("call sheet").
# The mailbox is Titan, which Hostinger resells — so the host is Titan's, NOT
# smtp.hostinger.com. Pointing at Hostinger gives a 535 that looks like a wrong
# password. SMTP_PASS is the Titan mailbox password, not the hPanel password.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=tcowan@moocowtv.com
SMTP_PASS=your-titan-mailbox-password
CONTACT_TO=tcowan@moocowtv.com
PORT=3000

# Optional: Cloudflare Turnstile ("I am human" check). Leave unset and the form
# still works, protected by the honeypot and time trap.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
